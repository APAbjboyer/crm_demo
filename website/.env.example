# Supabase — public values only (safe to expose client-side by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only. Used by lib/supabase/admin.ts for the CRM
# (people, contacts, activity_log, orders). Bypasses RLS — never expose
# to the client, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# CRM admin — comma-separated allowlist of emails permitted into /admin.
# Any other authenticated user (e.g. a chat-tool signup) is redirected away.
ADMIN_EMAILS=

# Configured directly in Vercel (Production/Preview/Development) via `vercel env add`.
# Local dev values live in website/.env.local (gitignored, not committed).
